# Groq key for copy generation (https://console.groq.com). Without it you still get the analysis and prompt.
GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant

# Long random string for sessions: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Defaults to sqlite:///muse.db (stored in instance/). Use Postgres in production.
# DATABASE_URL=postgresql://...

# Skip the headless Chrome scraping step even if Selenium is installed
DISABLE_SELENIUM=1
